# =============================================================================
# Smart Access Control — shared-hosting deployment
# =============================================================================
# Copy to .env on the host, fill it in, then:
#
#   docker compose -f docker-compose.prod.yml up -d --build
#
# This file is the whole configuration surface. The production image contains
# no .env of its own and will refuse to start without APP_KEY, deliberately:
# every container generating its own key would break sessions and encrypted
# columns across the stack.
#
# Generate the key once with:
#   docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show

APP_NAME="Smart Access Control"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://access.example.com
APP_TIMEZONE=UTC

# Loopback only — the host's Apache is the sole public entrance.
APP_PORT=8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database — the shared host's MySQL, outside this compose project
# -----------------------------------------------------------------------------
# `host.docker.internal` reaches a MySQL running on the host itself; the compose
# file maps it to the host gateway. Use the real hostname if the database lives
# elsewhere.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Run migrations on boot. Turn this off if your host wants schema changes
# applied deliberately rather than on deploy.
RUN_MIGRATIONS=true

# -----------------------------------------------------------------------------
# Redis — inside the stack, since shared hosts rarely provide one
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=access.example.com

# -----------------------------------------------------------------------------
# Sanctum — the dashboard is served from the same origin
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=access.example.com

# -----------------------------------------------------------------------------
# Broadcasting — Reverb
# -----------------------------------------------------------------------------
# Generate fresh values; these are credentials.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Where the Reverb process listens inside its own container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Where the *server* publishes events: the compose service, on the internal
# network. Not the same address the browser uses.
REVERB_PUBLISH_HOST=reverb
REVERB_PUBLISH_PORT=8080
REVERB_PUBLISH_SCHEME=http

# What the *browser* connects to — through Apache, on 443.
REVERB_HOST=access.example.com
REVERB_PORT=443
REVERB_SCHEME=https

# Loopback port Apache proxies the websocket to.
REVERB_HOST_PORT=8080

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="access@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# SMS
# -----------------------------------------------------------------------------
# `http` posts {to, from, text} with a bearer token — swap HttpSmsGateway for a
# provider SDK when you pick one. `null` reports failure honestly, for
# deployments where the panel's own modem is the only SMS path.
SMS_DRIVER=http
SMS_SENDER_ID=ACCESS
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=

# -----------------------------------------------------------------------------
# Access control domain settings
# -----------------------------------------------------------------------------
PHONE_DEFAULT_COUNTRY_CODE=+94

OTP_TTL_SECONDS=90
OTP_MAX_ATTEMPTS=3

# Leave false. True hands the plaintext OTP to anyone holding a device
# credential — the weakness the current contract exists to close (§7.3).
OTP_RETURN_CODE_TO_DEVICE=false
OTP_REQUIRE_ENROLLMENT=false

# True drops offline backup-code operation in exchange for never caching
# plaintext codes on the panel. For a *backup* method that may be the wrong
# trade; it is also settable per tenant.
BACKUP_CODES_ONLINE_ONLY=false
BACKUP_CODE_MAX_AGE_DAYS=90

DEVICE_OFFLINE_AFTER_SECONDS=100
DEVICE_COMMAND_TTL_SECONDS=300

# Phase-2 HMAC request signing. NOT IMPLEMENTED — it needs firmware that can
# sign against a server-provided epoch offset. Turning it on makes device
# authentication refuse every request, deliberately, so a deployment cannot
# believe it has signing when it does not.
DEVICE_REQUIRE_SIGNATURE=false

EVENT_DUPLICATE_WINDOW=10
# Retention is a compliance decision — see open question 3.
EVENT_RETENTION_DAYS=365

ACCESS_SCHEDULES_ENFORCE=true
ACCESS_SCHEDULE_TIMEZONE=Asia/Colombo
