# Smart Access Control — MySQL tuning for the single-instance EC2 deployment.
#
# Mounted into /etc/mysql/conf.d/. Stock MySQL 8.4 assumes it owns the machine;
# here it shares 2 GiB with nginx, four PHP processes, Redis and Caddy.

[mysqld]
# The largest single lever. 256M holds this schema's working set many times
# over — 22 tables, with access_events the only one that grows without bound.
innodb_buffer_pool_size = 256M
innodb_log_file_size    = 64M
innodb_flush_method     = O_DIRECT

# Durability over throughput. This is the system of record for who opened a
# door; a lost transaction is a lost audit entry.
innodb_flush_log_at_trx_commit = 1

# php-fpm allows 8 children, plus the queue worker, the scheduler and room for
# a mysqldump. 60 is generous.
max_connections = 60

# Frees roughly 200 MB. Turn it back on temporarily if you ever need to profile
# a slow query.
performance_schema = OFF

# Nothing speaks the X Protocol here.
mysqlx = OFF

table_open_cache   = 400
tmp_table_size     = 16M
max_heap_table_size = 16M

# Slow queries, for when a dashboard page starts dragging.
slow_query_log       = 1
slow_query_log_file  = /var/lib/mysql/slow.log
long_query_time      = 2
