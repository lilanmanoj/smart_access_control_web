# =============================================================================
# Smart Access Control — local development (docker compose up -d)
# =============================================================================
# Copy to .env. The entrypoint does this for you on first boot and generates
# APP_KEY if it is missing.
#
# This file is read twice: by Laravel inside the container, and by Docker
# Compose for variable substitution. Avoid `$` in values — Compose would try to
# interpolate it.

APP_NAME="Smart Access Control"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Host port the web container is published on.
APP_PORT=8000

# -----------------------------------------------------------------------------
# Reaching the app from another machine (LAN, a demo laptop, a phone)
# -----------------------------------------------------------------------------
# Set APP_URL to the address people will actually type, e.g.
#   APP_URL=http://10.21.82.125:8000
#
# Nothing else needs changing: the session cookie binds to whatever host served
# the page (SESSION_DOMAIN=null), local dev treats any browsing host as
# stateful, and the websocket falls back to the request host when REVERB_HOST
# is blank.
#
# One thing does matter: the Vite dev server writes its own address into
# public/hot, and @vite prefers that over the compiled assets. If you are
# serving to other machines, either stop it —
#   docker compose stop vite && rm -f public/hot
# — or tell it which address the browser can reach it on:
#   VITE_DEV_HOST=10.21.82.125

# The uid/gid the containers run as, so files they write into the
# bind-mounted source tree stay editable from the host. Set these to
# `id -u` / `id -g` if yours are not 1000.
UID=1000
GID=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — the `mysql` service in docker-compose.yml
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=smart_access
DB_USERNAME=smart_access
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Host-side port for connecting a GUI client to the dev database.
FORWARD_DB_PORT=3307

# -----------------------------------------------------------------------------
# Cache, queue, session — Redis
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
FORWARD_REDIS_PORT=6380

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Blank binds the session cookie to whatever host served the page, so
# localhost and a LAN address both work with no further config.
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# Sanctum — SPA session auth for the dashboard
# -----------------------------------------------------------------------------
# A floor, not the whole list: in local dev the current request host is
# also treated as stateful (see config/sanctum.php).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# -----------------------------------------------------------------------------
# Broadcasting — Laravel Reverb
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=smart-access
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret

# Where the Reverb process itself listens, inside its container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Where the *server* publishes events — the compose service name, on the
# internal network. Not the same address the browser uses.
REVERB_PUBLISH_HOST=reverb
REVERB_PUBLISH_PORT=8080
REVERB_PUBLISH_SCHEME=http

# What the *browser* connects to.
# Blank means "the host the page came from", which is what makes the
# websocket work over the LAN without another setting.
REVERB_HOST=
REVERB_PORT=8081
REVERB_SCHEME=http

# Host port the reverb container is published on. 8080 is a busy port on
# developer machines; 8081 is the default here for that reason.
REVERB_HOST_PORT=8081


VITE_PORT=5173

# The address the browser uses to reach the Vite dev server. localhost is
# right while you develop on this machine; set it to your LAN IP when
# other machines need the app.
VITE_DEV_HOST=localhost

# -----------------------------------------------------------------------------
# Mail — Mailpit catches everything locally at http://localhost:8025
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="access@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# -----------------------------------------------------------------------------
# SMS — `log` writes the message to the application log instead of sending it
# -----------------------------------------------------------------------------
SMS_DRIVER=log
SMS_SENDER_ID=ACCESS
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=

# -----------------------------------------------------------------------------
# Access control domain settings
# -----------------------------------------------------------------------------
PHONE_DEFAULT_COUNTRY_CODE=+94

OTP_TTL_SECONDS=90
OTP_MAX_ATTEMPTS=3
# Legacy firmware compatibility: return the plaintext OTP to the device.
# Leave false — the secure contract keeps the code server-side (§7.3).
OTP_RETURN_CODE_TO_DEVICE=false
OTP_REQUIRE_ENROLLMENT=false

# True drops offline backup-code operation in exchange for never caching
# plaintext codes on the panel.
BACKUP_CODES_ONLINE_ONLY=false
BACKUP_CODE_MAX_AGE_DAYS=90

DEVICE_OFFLINE_AFTER_SECONDS=100
DEVICE_COMMAND_TTL_SECONDS=300
DEVICE_REQUIRE_SIGNATURE=false

EVENT_DUPLICATE_WINDOW=10
EVENT_RETENTION_DAYS=365

ACCESS_SCHEDULES_ENFORCE=true
ACCESS_SCHEDULE_TIMEZONE=Asia/Colombo

# -----------------------------------------------------------------------------
# Demo seed — created by `php artisan db:seed`
# -----------------------------------------------------------------------------
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=password
